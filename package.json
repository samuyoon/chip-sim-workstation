{
  "name": "chip-sim-workstation",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first circuit simulation workstation",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "package:mac": "npm run build && electron-builder --mac --arm64",
    "stage:ngspice": "node scripts/stage-ngspice.mjs",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "simulate:example": "tsx scripts/simulate-example.ts",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@xyflow/react": "12.11.2",
    "electron": "37.10.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "uplot": "1.6.32",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "electron-builder": "26.0.12",
    "electron-vite": "4.0.1",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "jsdom": "26.1.0",
    "prettier": "3.7.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vite": "6.4.3",
    "vitest": "3.2.4"
  }
}
